# Development Environment Variables
# Copy this to .env in backend/ and .env.local in frontend/

# Database
DATABASE_URL="postgresql://arogyamitra:arogyamitra_dev_password@localhost:5432/arogyamitra"

# Redis (optional)
REDIS_URL="redis://localhost:6379"

# JWT Configuration
JWT_SECRET="arogyamitra-dev-jwt-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"
REFRESH_TOKEN_SECRET="arogyamitra-dev-refresh-token-secret"
REFRESH_TOKEN_EXPIRES_IN="30d"

# Server Configuration
PORT=3001
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE="10MB"
UPLOAD_PATH="./uploads"

# Logging
LOG_LEVEL="debug"
LOG_FILE="logs/app.log"

# Health Check
HEALTH_CHECK_INTERVAL=30000

# Email (SendGrid) - Optional for development
# SENDGRID_API_KEY="your-sendgrid-api-key"
# FROM_EMAIL="noreply@arogyamitra.com"

# SMS (Twilio) - Optional for development
# TWILIO_ACCOUNT_SID="your-twilio-account-sid"
# TWILIO_AUTH_TOKEN="your-twilio-auth-token"
# TWILIO_PHONE_NUMBER="+1234567890"