# Database
DATABASE_URL="postgresql://arogyamitra:arogyamitra_dev_password@localhost:5432/arogyamitra"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="arogyamitra-jwt-secret-key-change-in-production-make-it-very-long-and-secure"
JWT_EXPIRES_IN="7d"
REFRESH_TOKEN_SECRET="arogyamitra-refresh-token-secret-also-very-long-and-secure"
REFRESH_TOKEN_EXPIRES_IN="30d"

# Server
PORT=3001
NODE_ENV="development"

# CORS
CORS_ORIGIN="http://localhost:3000"

# Email (SendGrid)
SENDGRID_API_KEY="your-sendgrid-api-key"
FROM_EMAIL="noreply@arogyamitra.com"

# SMS (Twilio)
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# File Upload
MAX_FILE_SIZE="10MB"
UPLOAD_PATH="./uploads"

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL="info"
LOG_FILE="logs/app.log"

# Health Check
HEALTH_CHECK_INTERVAL=30000